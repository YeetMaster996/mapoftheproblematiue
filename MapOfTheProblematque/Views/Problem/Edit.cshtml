@model Problem

@{
    ViewData["Title"] = "Edit";
}

<div class="container my-auto">
    <div class="row justify-content-center">

        <div class="row col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-md-5">

                <h3>Edit Problem</h3>
                <hr />

                <form asp-action="Edit">
                    <div class="form-group ">
                        <label asp-for="Id" class="control-label"></label>
                        <input asp-for="Id" class="form-control" disabled/>
                        <span asp-validation-for="Id" class="text-danger"></span>


                    </div>
                    <div class="form-group ">
                        <label asp-for="Name" class="control-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>


                    </div>

                    <div class="form-group">
                        <label asp-for="Category" class="control-label"></label>
                        <select asp-for="Category" class="form-control" asp-items="ViewBag.ProblemType">
                            <option value="">-- Select Problem Type --</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>

                    </div>

       
                    <div class="form-group">
                        <label asp-for="Description" class="control-label"></label>
                        <textarea rows="4" asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>


                    </div>
                    <div class="form-group">
                        <label asp-for="Priority" class="control-label"></label>
                        <input asp-for="Priority" class="form-control" />
                        <small class="form-text text-muted">lower number translates to higher priority with the highest being 1 </small>
                        <span asp-validation-for="Priority" class="text-danger"></span>

                    </div>

                    <div class="form-group">
                        <label asp-for="City.Country.Name" class="control-label"></label>
                        <select asp-for="City.CountryId" class="form-select" asp-items="ViewBag.Countries" onchange="getCities(this.value)">
                            <option value="">-- Select Country --</option>
                        </select>
                        <span asp-validation-for="City.CountryId" class="text-danger"></span>

                    </div>
                    <div class="form-group">
                        <label asp-for="City" class="control-label"></label>
                        <select asp-for="CityId" class="form-select">
                            <option value="">-- Select Country to load Cities --</option>
                        </select>
                        <span asp-validation-for="CityId" class="text-danger"></span>

                    </div>

        

                    
                    <div class="form-group mt-3 d-flex align-items-center gap-3">
                        <input type="submit" value="Save" class="btn btn-primary " />
                        <a asp-action="Index">Back to List</a>
                    </div>

                </form>

       
               

            </div>
        </div>
    </div>
</div>
@* <div class="mt-3">
    <a class="btn btn-info d-inline" asp-action="Index">Back to List</a>
</div> *@

<script>
    function getCities() {

        var countryId = $('#CountryId').val(); // Get the selected country ID from the dropdown
        
        // Display the selected country ID in an alert
        // Make an AJAX request to fetch states based on the selected country
        $.ajax({
            url: '/Problem/GetCities', // Replace with your actual controller and action
            type: 'GET',
            data: { countryId: countryId },
            success: function(data) {
                // Populate the states dropdown with the received data
                var stateDropdown = $('#CityId');
                stateDropdown.empty(); // Clear existing options
                $.each(data, function(index, city) {
                    stateDropdown.append($('<option>', {
                        value: city.cityId,
                        text: city.cityName
                    }));
                });
            },
            error: function() {
                alert('Error fetching Cities.');
            }
        });
    }
   

</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }

     <script>
$(document).ready(function() {
      getCities(); // Call the function to load cities when the page is ready
    
       
    });
</script>
}